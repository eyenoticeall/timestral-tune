{
  "model": "mistralai/Timestral-28M",
  "device": "mps",
  "disclosure": "Initial ad-hoc screening prior to pre-registration evaluated zero-shot 28M vs an exploratory Ridge baseline on the test split. This script records both validation-split and test-split comparisons against the final run_tuned_classical baseline.",
